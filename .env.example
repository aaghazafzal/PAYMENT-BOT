# Univora Payment Bot & Ecosystem Subscription Engine Configuration

# 1. Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789 # Comma-separated Telegram User IDs for Admin privileges

# 2. Database Configuration
MONGO_URI=mongodb+srv://moneybot:YOUR_PASSWORD@moneybot.0yaxppo.mongodb.net/?appName=moneybot

# 3. Cashfree API Credentials (v3)
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=TEST # Options: TEST or PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# 4. Server & Webhook Configuration
PORT=5000
SERVER_URL=http://localhost:5000 # Public HTTPS domain or Ngrok URL for Cashfree callbacks/webhooks

# 5. Ecosystem Security Secret
ECOSYSTEM_API_SECRET=univora_ultra_secret_key_2026_change_me
